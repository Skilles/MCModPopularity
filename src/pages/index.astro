---
import Layout from '../layouts/Layout.astro';
import VersionChart from '../components/VersionChart.tsx';
import LoaderChart from '../components/LoaderChart.tsx';
import PlatformShare from '../components/PlatformShare.tsx';
import TrendChart from '../components/TrendChart.tsx';
import {
  chartFamilies, familyScoreInput, fmt, LOADERS, popularityScores, total,
  type Dataset, type Snapshot,
} from '../lib/data';
import dataset from '../../data/latest.json';

const data = dataset as unknown as Dataset;
const families = chartFamilies(data);
const snapshots = Object.values(
  import.meta.glob('../../data/snapshots/*.json', { eager: true, import: 'default' }),
) as Snapshot[];

const totalDownloads = data.totals.cf.downloads + data.totals.mr.downloads;
const totalProjects =
  data.totals.cf.mods + data.totals.cf.modpacks + data.totals.mr.mods + data.totals.mr.modpacks;

const topScored = popularityScores(families.map(familyScoreInput), data.generatedAt)
  .sort((a, b) => b.score - a.score)[0];
const newest = families.filter((f) => f.cf.mods + f.mr.mods >= 500).at(-1) ?? families.at(-1)!;
const loaderCounts = LOADERS.map((l) => ({ l, n: newest.cf.loaders[l] + newest.mr.loaders[l] }));
const loaderSum = loaderCounts.reduce((a, c) => a + c.n, 0);
const topLoader = loaderCounts.sort((a, b) => b.n - a.n)[0];
const loaderNames = { fabric: 'Fabric', forge: 'Forge', neoforge: 'NeoForge', quilt: 'Quilt' };
---
<Layout title="MC Mod Popularity" generatedAt={data.generatedAt}>
  <div class="tiles">
    <div class="tile" style="--tile-accent: var(--grass)">
      <div class="k">Most popular version</div>
      <div class="v">{topScored.name}</div>
      <div class="d">popularity score {topScored.score} / 100</div>
    </div>
    <div class="tile" style="--tile-accent: var(--gold)">
      <div class="k">Total downloads</div>
      <div class="v">{fmt(totalDownloads)}</div>
      <div class="d">across {fmt(data.sweptProjects.cf + data.sweptProjects.mr)} indexed projects</div>
    </div>
    <div class="tile" style="--tile-accent: var(--forge)">
      <div class="k">Projects tracked</div>
      <div class="v">{data.totals.cf.modsApprox ? '~' : ''}{fmt(totalProjects)}</div>
      <div class="d">mods + modpacks on both platforms</div>
    </div>
    <div class="tile" style="--tile-accent: var(--quilt)">
      <div class="k">Top loader · {newest.key}</div>
      <div class="v">{loaderNames[topLoader.l]}</div>
      <div class="d">{Math.round((topLoader.n / loaderSum) * 100)}% of {newest.key} mods</div>
    </div>
  </div>

  <div class="card">
    <VersionChart client:load families={families} generatedAt={data.generatedAt} />
  </div>

  <div class="two">
    <div class="card">
      <div class="card-head" style="margin-bottom: 14px">
        <div>
          <h2>Loader share by version</h2>
          <div class="note">Share of mods per family, newest first</div>
        </div>
      </div>
      <LoaderChart client:visible families={families} />
    </div>
    <div class="card">
      <div class="card-head" style="margin-bottom: 14px">
        <div>
          <h2>CurseForge vs Modrinth</h2>
          <div class="note">Platform share per family, newest first</div>
        </div>
      </div>
      <PlatformShare client:visible families={families} totals={data.totals} />
    </div>
  </div>

  <div class="card">
    <div class="card-head">
      <div>
        <h2>Version share over time</h2>
        <div class="note">Share of combined downloads per family</div>
      </div>
    </div>
    <TrendChart client:visible snapshots={snapshots} />
  </div>

  <p class="footer-note">
    Download totals sum every project reached by the download sweeps (global top {fmt(data.sweepSize.mods)} plus per-version filtered sweeps, deduplicated).
    Counts marked ~ are approximate — CurseForge caps search results at 10,000, so larger counts are
    reconstructed from per-loader queries. "Recently updated" means updated on Modrinth in the last {data.activeDays} days.
    Version + loader combinations are matched per project, so a mod shipping
    several loaders counts toward each; combinations that predate a loader's existence are excluded.
    Cross-posted projects are counted once per platform.
    Data from the <a href="https://docs.curseforge.com/">CurseForge</a> and <a href="https://docs.modrinth.com/">Modrinth</a> APIs, refreshed daily.
  </p>
</Layout>
