---
import '../styles/global.css';

interface Props {
  title: string;
  generatedAt: string;
}
const { title, generatedAt } = Astro.props;
const updated = new Date(generatedAt).toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).toUpperCase();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The most popular Minecraft versions and mod loaders, measured by mod and modpack counts and downloads on CurseForge and Modrinth. Updated daily." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem('theme')
        ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.blocks = localStorage.getItem('blocks') ?? 'off';
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <div class="brand">
          <div class="logo" role="button" tabindex="0" title="Toggle block textures" aria-label="Toggle block textures">
            {Array.from({ length: 16 }).map(() => <i></i>)}
          </div>
          <h1>MC <span class="accent">Mod Popularity</span></h1>
        </div>
        <div class="header-right">
          <div class="updated" data-ts={generatedAt}>UPDATED {updated}</div>
          <button class="theme-toggle blocks-toggle" aria-label="Toggle block textures" title="Toggle block textures">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="1" y="3" width="14" height="4" fill="var(--grass)" />
              <rect x="1" y="7" width="14" height="6" fill="var(--dirt)" />
            </svg>
          </button>
          <button class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
        </div>
      </header>
      <slot />
    </div>
    <script>
      document.querySelector('.theme-toggle:not(.blocks-toggle)')!.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      // Easter egg: clicking the grass-block logo toggles Minecraft bar textures.
      const toggleBlocks = () => {
        const next = document.documentElement.dataset.blocks === 'on' ? 'off' : 'on';
        document.documentElement.dataset.blocks = next;
        localStorage.setItem('blocks', next);
      };
      const logo = document.querySelector<HTMLElement>('.logo')!;
      logo.addEventListener('click', toggleBlocks);
      logo.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleBlocks(); }
      });
      document.querySelector('.blocks-toggle')!.addEventListener('click', toggleBlocks);

      // Re-render the build-time (UTC) timestamp in the viewer's timezone.
      const updatedEl = document.querySelector<HTMLElement>('.updated')!;
      const ts = new Date(updatedEl.dataset.ts!);
      if (!Number.isNaN(ts.getTime())) {
        updatedEl.textContent = 'UPDATED ' + ts
          .toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })
          .toUpperCase();
      }
    </script>
  </body>
</html>
